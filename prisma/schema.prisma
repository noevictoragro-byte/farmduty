// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTENTICAÇÃO & MULTI-TENANT
// ============================================

model Organization {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique

  // White-Label Configuration
  customLogoUrl       String?
  appName             String?   @default("FarmDuty")
  primaryColor        String?   @default("#22c55e") // Green by default

  // Organization Metadata
  ownerEmail          String
  ownerId             String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  members             User[]
  properties          Property[]
  partners            Partner[]
  transactions        FinancialTransaction[]
  operationalRecords  OperationalRecord[]
  collaborators       Collaborator[]
  fleetVehicles       FleetVehicle[]
  harvests            Harvest[]
  wallets             Wallet[]
  syncQueue           SyncQueue[]

  @@index([slug])
  @@index([ownerEmail])
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  role                UserRole  @default(OPERATIONAL)

  // Organization membership
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Session & Auth
  lastLoginAt         DateTime?
  isActive            Boolean   @default(true)

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([email, organizationId])
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATIONAL
  VIEWER
}

// ============================================
// CARTEIRAS FINANCEIRAS
// ============================================

enum WalletType {
  FARM      // Carteira Fazenda (custos operacionais)
  PERSONAL  // Carteira Pessoal (pró-labore e despesas pessoais)
}

model Wallet {
  id                  String    @id @default(cuid())
  type                WalletType
  balance             Decimal   @default(0) @db.Decimal(15, 2)

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  transactions        FinancialTransaction[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([organizationId, type])
  @@index([organizationId])
}

enum TransactionType {
  INCOME      // Receita
  EXPENSE     // Despesa
  TRANSFER    // Transferência entre carteiras
}

enum TransactionStatus {
  PENDING     // Pendente (a receber/pagar)
  CONFIRMED   // Confirmado
  CANCELLED   // Cancelado
  PAID        // Pago
  RECEIVED    // Recebido
}

enum ExpenseCategory {
  // Carteira Fazenda
  SEEDS               // Sementes
  FERTILIZERS         // Fertilizantes
  PESTICIDES          // Pesticidas/Defensivos
  FUEL                // Diesel/Combustível
  MACHINE_RENTAL      // Aluguel de máquinas
  MACHINE_MAINTENANCE // Manutenção de máquinas
  LABOR               // Mão de obra/Diárias
  FREIGHT             // Fretes
  INPUTS              // Outros insumos

  // Carteira Pessoal
  PAYOUT              // Pró-labore/Retirada
  FOOD                // Alimentação
  HEALTH              // Saúde
  EDUCATION           // Educação
  UTILITIES           // Contas/Utilidades
  PERSONAL_TAX        // Impostos pessoais
  OTHER               // Outro
}

model FinancialTransaction {
  id                  String    @id @default(cuid())

  // Basic info
  type                TransactionType
  status              TransactionStatus @default(PENDING)
  category            ExpenseCategory
  description         String
  amount              Decimal   @db.Decimal(15, 2)

  // Dates
  transactionDate     DateTime
  dueDate             DateTime?
  paidDate            DateTime?

  // Relations
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  walletId            String
  wallet              Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  partnerId           String?
  partner             Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  // Attachment (nota fiscal, boleto, etc)
  attachmentUrl       String?

  // AI-assisted entry
  operationalRecordId String?   @unique
  operationalRecord   OperationalRecord? @relation(fields: [operationalRecordId], references: [id], onDelete: SetNull)

  // Metadata
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?

  @@index([organizationId])
  @@index([walletId])
  @@index([partnerId])
  @@index([transactionDate])
  @@index([dueDate])
  @@index([status])
}

// ============================================
// PARCEIROS COMERCIAIS
// ============================================

enum PartnerType {
  SUPPLIER        // Fornecedor de insumos
  SERVICE_PROVIDER // Prestador de serviço
  BUYER           // Comprador/Varejista
  TRANSPORTER     // Transportador/Fretes
  OTHER           // Outro
}

model Partner {
  id                  String    @id @default(cuid())
  name                String
  type                PartnerType
  email               String?
  phone               String?

  // Address
  address             String?
  city                String?
  state               String?
  zipCode             String?

  // Document
  documentType        String?   // CPF ou CNPJ
  documentNumber      String?   @unique

  // Details
  bankAccount         String?
  notes               String?
  isActive            Boolean   @default(true)

  // Organization
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  transactions        FinancialTransaction[]
  quotes              Quote[]
  shipments           Shipment[]
  maintenanceRecords  MaintenanceRecord[]

  // Ratings & History
  averageRating       Float?
  lastTransactionDate DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([documentNumber])
  @@unique([organizationId, name])
}

model Quote {
  id                  String    @id @default(cuid())

  partnerId           String
  partner             Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Quote Details
  productName         String
  quantity            Decimal   @db.Decimal(10, 2)
  unit                String    // kg, L, unidade, etc
  pricePerUnit        Decimal   @db.Decimal(15, 4)
  totalPrice          Decimal   @db.Decimal(15, 2)
  validUntilDate      DateTime?

  // AI-assisted entry
  operationalRecordId String?   @unique
  operationalRecord   OperationalRecord? @relation(fields: [operationalRecordId], references: [id], onDelete: SetNull)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([partnerId])
}

// ============================================
// PROPRIEDADES & TALHÕES
// ============================================

model Property {
  id                  String    @id @default(cuid())
  name                String
  location            String?
  areaHectares        Decimal?  @db.Decimal(10, 2)

  // GPS Coordinates
  latitude            Float?
  longitude           Float?

  // Land info
  soilType            String?
  ownershipType       String?   // Própria, Arrendada, Parceria

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plots               Plot[]
  harvests            Harvest[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
}

model Plot {
  id                  String    @id @default(cuid())
  name                String
  areaHectares        Decimal   @db.Decimal(10, 2)

  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Crop info
  currentCrop         String?
  plantingDate        DateTime?
  expectedHarvestDate DateTime?

  harvests            Harvest[]
  operationalRecords  OperationalRecord[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([propertyId])
}

// ============================================
// FROTA & MANUTENÇÃO
// ============================================

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model FleetVehicle {
  id                  String    @id @default(cuid())
  name                String
  type                String    // Trator, Colheitadeira, Caminhão, etc
  brand               String?
  model               String?
  yearManufactured    Int?
  licensePlate        String?   @unique

  status              VehicleStatus @default(ACTIVE)
  acquisitionValue    Decimal?  @db.Decimal(12, 2)
  fuelConsumption     Decimal?  @db.Decimal(8, 2) // L/h ou km/L

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  maintenanceRecords  MaintenanceRecord[]
  operationalRecords  OperationalRecord[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([licensePlate])
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
}

model MaintenanceRecord {
  id                  String    @id @default(cuid())
  type                MaintenanceType
  description         String
  scheduledDate       DateTime?
  completionDate      DateTime?
  cost                Decimal?  @db.Decimal(12, 2)

  vehicleId           String
  vehicle             FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  partnerId           String?
  partner             Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([vehicleId])
  @@index([scheduledDate])
}

// ============================================
// COLHEITAS & FRETES
// ============================================

model Harvest {
  id                  String    @id @default(cuid())

  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  plotId              String?
  plot                Plot? @relation(fields: [plotId], references: [id], onDelete: SetNull)

  harvestDate         DateTime
  crop                String
  quantityBags        Decimal?  @db.Decimal(10, 2)
  quantityTons        Decimal?  @db.Decimal(10, 2)

  // Yield calculation
  expectedYield       Decimal?  @db.Decimal(10, 2)
  actualYield         Decimal?  @db.Decimal(10, 2)

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  shipments           Shipment[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([harvestDate])
}

model Shipment {
  id                  String    @id @default(cuid())

  harvestId           String
  harvest             Harvest @relation(fields: [harvestId], references: [id], onDelete: Cascade)

  transporterId       String?
  transporter         Partner? @relation(fields: [transporterId], references: [id], onDelete: SetNull)

  shipmentDate        DateTime
  origin              String?
  destination         String?

  quantity            Decimal   @db.Decimal(10, 2)
  freightCost         Decimal?  @db.Decimal(12, 2)

  invoiceNumber       String?   @unique
  trackingNumber      String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([harvestId])
  @@index([transporterId])
}

// ============================================
// COLABORADORES & DIÁRIAS
// ============================================

enum EmploymentType {
  FIXED       // Funcionário registrado
  TEMPORARY   // Trabalhador temporário
  DAILY_WAGE  // Diarista
  CONTRACTOR  // Contratado
}

model Collaborator {
  id                  String    @id @default(cuid())
  name                String
  role                String    // Operador, Peão, Supervisor, etc
  employmentType      EmploymentType

  // Contact info
  email               String?
  phone               String?

  // Document
  documentNumber      String?   // CPF
  bankAccount         String?

  // Dates
  hireDate            DateTime?
  releaseDate         DateTime?
  isActive            Boolean   @default(true)

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dailyRecords        DailyRecord[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([documentNumber])
}

model DailyRecord {
  id                  String    @id @default(cuid())

  collaboratorId      String
  collaborator        Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  workDate            DateTime
  workType            String    // Plantio, Colheita, Capinagem, etc
  hoursWorked         Decimal   @db.Decimal(4, 2)
  dailyRate           Decimal   @db.Decimal(8, 2)
  totalAmount         Decimal   @db.Decimal(10, 2)

  plotId              String?
  taskDescription     String?
  notes               String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([collaboratorId])
  @@index([workDate])
}

// ============================================
// REGISTROS OPERACIONAIS & IA
// ============================================

enum OperationalRecordType {
  EXPENSE
  INCOME
  TASK
  NOTE
  QUOTE_REQUEST
}

enum OperationalRecordSource {
  WHATSAPP_VOICE  // Áudio do WhatsApp
  WHATSAPP_IMAGE  // Foto/printscreen
  WHATSAPP_TEXT   // Mensagem de texto
  MOBILE_APP      // App mobile direto
  WEB_FORM        // Formulário web
  OCR_SCAN        // Leitura de documento
}

model OperationalRecord {
  id                  String    @id @default(cuid())

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type                OperationalRecordType
  source              OperationalRecordSource

  // Raw input data
  rawInput            String    // Áudio transcrito, texto, ou OCR bruto
  audioUrl            String?   // URL do arquivo de áudio original
  imageUrl            String?   // URL da imagem/foto

  // AI Extraction (metadata)
  rawTranscription    String?   // Transcrição completa do áudio
  extractedData       Json?     // Dados estruturados extraídos
  confidenceScore     Float?    // 0.0 a 1.0 de confiança da IA

  // Processing status
  isProcessed         Boolean   @default(false)
  processingStatus    String?   // PENDING, PROCESSING, COMPLETED, FAILED
  processingError     String?   // Mensagem de erro, se houver

  // Relations (criado a partir de um registro OperationalRecord)
  transaction         FinancialTransaction?
  quote               Quote?
  plotId              String?
  plot                Plot? @relation(fields: [plotId], references: [id], onDelete: SetNull)
  vehicleId           String?
  vehicle             FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // User who triggered
  createdByEmail      String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  processedAt         DateTime?

  @@index([organizationId])
  @@index([source])
  @@index([isProcessed])
  @@index([createdAt])
}

// ============================================
// SINCRONIZAÇÃO OFFLINE
// ============================================

enum SyncOperation {
  INSERT
  UPDATE
  DELETE
}

model SyncQueue {
  id                  String    @id @default(cuid())

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityType          String    // Nome da tabela/modelo
  operation           SyncOperation
  entityId            String    // ID da entidade
  payload             Json      // Dados completos

  isSynced            Boolean   @default(false)
  syncedAt            DateTime?
  retryCount          Int       @default(0)
  lastError           String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([isSynced])
  @@index([createdAt])
}
